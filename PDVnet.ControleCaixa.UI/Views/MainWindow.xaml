<Window x:Class="PDVnet.ControleCaixa.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:PDVnet.ControleCaixa.UI.ViewModels"
        xmlns:views="clr-namespace:PDVnet.ControleCaixa.UI.Views"
        Title="Controle de Caixa - PDVnet" Height="720" Width="1080" 
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="#E5E2E1"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodels:MovimentacoesViewModel}">
            <views:MovimentacoesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:CategoriasViewModel}">
            <views:CategoriasView />
        </DataTemplate>
    </Window.Resources>

    <materialDesign:DialogHost Identifier="RootDialog" DialogTheme="Inherit">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource PrimaryHueMidBrush}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,30,0,30">
                        <Image Source="pack://application:,,,/Assets/logo.png" Width="120" Height="120" Margin="0,0,0,15" Stretch="Uniform"/>
                        <TextBlock Text="PDVnet" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#FFFFFF"/>
                        <TextBlock Text="Controle de Caixa" FontSize="14" HorizontalAlignment="Center" Foreground="#FFFFFF" Opacity="0.8"/>
                    </StackPanel>
                    <StackPanel Margin="0,10,0,0">
                        <Button Height="50" HorizontalContentAlignment="Left" Command="{Binding AbrirMovimentacoesCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                    <Setter Property="Opacity" Value="0.7" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMovimentacoesSelected}" Value="True">
                                            <Setter Property="Background" Value="#1AFFFFFF" />
                                            <Setter Property="Opacity" Value="1.0" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ViewList" Width="24" Height="24" VerticalAlignment="Center">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMovimentacoesSelected}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryHueMidBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <TextBlock Text="Movimentações" Margin="15,0,0,0" FontSize="16" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Height="50" HorizontalContentAlignment="Left" Command="{Binding AbrirDashboardCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                    <Setter Property="Opacity" Value="0.7" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDashboardSelected}" Value="True">
                                            <Setter Property="Background" Value="#1AFFFFFF" />
                                            <Setter Property="Opacity" Value="1.0" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ViewDashboard" Width="24" Height="24" VerticalAlignment="Center">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDashboardSelected}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryHueMidBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <TextBlock Text="Dashboard" Margin="15,0,0,0" FontSize="16" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Height="50" HorizontalContentAlignment="Left" Command="{Binding AbrirCategoriasCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                    <Setter Property="Opacity" Value="0.7" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCategoriasSelected}" Value="True">
                                            <Setter Property="Background" Value="#1AFFFFFF" />
                                            <Setter Property="Opacity" Value="1.0" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FormatListBulletedType" Width="24" Height="24" VerticalAlignment="Center">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCategoriasSelected}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryHueMidBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <TextBlock Text="Categorias" Margin="15,0,0,0" FontSize="16" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <DockPanel Grid.Column="1" Background="#E5E2E1">
                <materialDesign:ColorZone Padding="16" Mode="Standard" DockPanel.Dock="Top" Background="#FFFFFF" Margin="10,10,10,0" CornerRadius="10" materialDesign:ShadowAssist.ShadowDepth="Depth1">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#333333" VerticalAlignment="Center">
                                Sistema de Controle de Caixa
                            </TextBlock>
                            <Border Background="#FFD700" CornerRadius="5" Margin="20,0,0,0" Padding="10,5"
                                    Visibility="{Binding MostrarAlerta, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding MensagemAlerta}" Foreground="#DC143C" FontWeight="Bold" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </materialDesign:ColorZone>
                <Grid Margin="10">
                    <Border Background="#FFFFFF" CornerRadius="10" materialDesign:ShadowAssist.ShadowDepth="Depth1">
                        <ContentControl Content="{Binding CurrentViewModel}" />
                    </Border>
                </Grid>
            </DockPanel>
        </Grid>
    </materialDesign:DialogHost>
</Window>
