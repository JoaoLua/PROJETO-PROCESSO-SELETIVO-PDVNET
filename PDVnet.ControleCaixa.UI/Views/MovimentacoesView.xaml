<UserControl x:Class="PDVnet.ControleCaixa.UI.Views.MovimentacoesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#FFFFFF">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Gerenciar Movimentações" 
                       FontSize="24" FontWeight="Bold" 
                       VerticalAlignment="Center" Foreground="#021651" 
                       Margin="0,0,15,0" />
                       
            <Button Content="+ Novo Lançamento"
                    Command="{Binding NovaMovimentacaoCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#021651" BorderBrush="#021651" Foreground="#FFFFFF"
                    Height="36" FontSize="14" Padding="15,0" VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                <TextBox materialDesign:HintAssist.Hint="Buscar por descrição..."
                         materialDesign:HintAssist.IsFloating="True"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Text="{Binding TextoBusca, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="16" Margin="0,0,15,0" Width="300" />
            </StackPanel>

            <WrapPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                <DatePicker materialDesign:HintAssist.Hint="Data Inicial"
                            materialDesign:HintAssist.IsFloating="True"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                            SelectedDate="{Binding DataInicio, UpdateSourceTrigger=PropertyChanged}"
                            FontSize="16" Margin="0,0,15,10" Width="140" />

                <DatePicker materialDesign:HintAssist.Hint="Data Final"
                            materialDesign:HintAssist.IsFloating="True"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                            SelectedDate="{Binding DataFim, UpdateSourceTrigger=PropertyChanged}"
                            FontSize="16" Margin="0,0,15,10" Width="140" />

                <ComboBox materialDesign:HintAssist.Hint="Tipo"
                          materialDesign:HintAssist.IsFloating="True"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          ItemsSource="{Binding TiposDisponiveis}"
                          SelectedItem="{Binding TipoSelecionado, UpdateSourceTrigger=PropertyChanged}"
                          FontSize="14" Margin="0,0,15,10" Width="130" />

                <ComboBox materialDesign:HintAssist.Hint="Categoria"
                          materialDesign:HintAssist.IsFloating="True"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          ItemsSource="{Binding CategoriasDisponiveis}"
                          SelectedItem="{Binding CategoriaSelecionada, UpdateSourceTrigger=PropertyChanged}"
                          FontSize="14" Margin="0,0,15,10" Width="180" />

                <CheckBox Content="Somente Inativos"
                          IsChecked="{Binding SomenteInativos, UpdateSourceTrigger=PropertyChanged}"
                          VerticalAlignment="Center"
                          Margin="0,0,15,10" />
            </WrapPanel>
        </Grid>

        <TextBlock Grid.Row="2" 
                   Text="{Binding MensagemErroFiltro}" 
                   Foreground="#DC143C" 
                   FontWeight="SemiBold"
                   Margin="0,0,0,10"
                   Visibility="{Binding TemErroFiltro, Converter={StaticResource BoolToVis}}" />

        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Movimentacoes}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  materialDesign:DataGridAssist.CellPadding="13 8 8 8"
                  materialDesign:DataGridAssist.ColumnHeaderPadding="8"
                  Background="Transparent"
                  BorderThickness="1"
                  BorderBrush="#E5E2E1"
                  RowStyle="{StaticResource MaterialDesignDataGridRow}"
                  CellStyle="{StaticResource MaterialDesignDataGridCell}"
                  ColumnHeaderStyle="{StaticResource MaterialDesignDataGridColumnHeader}">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Data" Binding="{Binding DataMovimento, StringFormat=dd/MM/yyyy HH:mm}" Width="150" />
                <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*" />
                <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="120" />
                <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria}" Width="150" />
                <DataGridTextColumn Header="Valor" Binding="{Binding Valor, StringFormat=C}" Width="120" >
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tipo}" Value="Entrada">
                                    <Setter Property="Foreground" Value="Green"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tipo}" Value="Saida">
                                    <Setter Property="Foreground" Value="#DC143C"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="Ações" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource MaterialDesignIconForegroundButton}"
                                        Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Editar Lançamento"
                                        Width="30" Height="30" Padding="0">
                                    <materialDesign:PackIcon Kind="Pencil" Width="18" Height="18" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                </Button>
                                <Button CommandParameter="{Binding}"
                                        Width="30" Height="30" Padding="0" Margin="5,0,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconForegroundButton}">
                                            <Setter Property="Command" Value="{Binding DataContext.DeletarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                            <Setter Property="ToolTip" Value="Excluir Lançamento" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="False">
                                                    <Setter Property="Command" Value="{Binding DataContext.ReativarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                    <Setter Property="ToolTip" Value="Reativar Lançamento" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <materialDesign:PackIcon Width="18" Height="18">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="TrashCan" />
                                                <Setter Property="Foreground" Value="#DC143C" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="False">
                                                        <Setter Property="Kind" Value="Restore" />
                                                        <Setter Property="Foreground" Value="Green" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
