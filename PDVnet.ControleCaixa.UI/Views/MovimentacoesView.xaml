<UserControl x:Class="PDVnet.ControleCaixa.UI.Views.MovimentacoesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#FFFFFF">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho: Busca e Botão Novo -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Filtros (StackPanel p/ alinhar à esquerda) -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <!-- Barra de Busca ligada ao 'TextoBusca' do ViewModel -->
                <TextBox materialDesign:HintAssist.Hint="Buscar por descrição..."
                         materialDesign:HintAssist.IsFloating="True"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Text="{Binding TextoBusca, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="16" Margin="0,0,15,0" Width="250" />
                         
                <!-- Data Inicial -->
                <DatePicker materialDesign:HintAssist.Hint="Data Inicial"
                            materialDesign:HintAssist.IsFloating="True"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                            SelectedDate="{Binding DataInicio, UpdateSourceTrigger=PropertyChanged}"
                            FontSize="16" Margin="0,0,15,0" Width="140" />

                <!-- Data Final -->
                <DatePicker materialDesign:HintAssist.Hint="Data Final"
                            materialDesign:HintAssist.IsFloating="True"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                            SelectedDate="{Binding DataFim, UpdateSourceTrigger=PropertyChanged}"
                            FontSize="16" Margin="0,0,15,0" Width="140" />
            </StackPanel>

            <!-- Botão Nova Movimentação -->
            <Button Grid.Column="1"
                    Content="+ Novo Lançamento"
                    Command="{Binding NovaMovimentacaoCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#021651" BorderBrush="#021651" Foreground="#FFFFFF"
                    Height="45" FontSize="15" />
        </Grid>
        
        <!-- Mensagem de Erro do Filtro (Ex: Data Início > Data Fim) -->
        <TextBlock Grid.Row="1" 
                   Text="{Binding MensagemErroFiltro}" 
                   Foreground="#DC143C" 
                   FontWeight="SemiBold"
                   Margin="0,0,0,10"
                   Visibility="{Binding TemErroFiltro, Converter={StaticResource BoolToVis}}" />

        <!-- Tabela (DataGrid) ligada à lista 'Movimentacoes' do ViewModel -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Movimentacoes}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  materialDesign:DataGridAssist.CellPadding="13 8 8 8"
                  materialDesign:DataGridAssist.ColumnHeaderPadding="8"
                  Background="Transparent"
                  BorderThickness="1"
                  BorderBrush="#E5E2E1"
                  RowStyle="{StaticResource MaterialDesignDataGridRow}"
                  CellStyle="{StaticResource MaterialDesignDataGridCell}"
                  ColumnHeaderStyle="{StaticResource MaterialDesignDataGridColumnHeader}">
            
            <DataGrid.Columns>
                <DataGridTextColumn Header="Data" Binding="{Binding DataMovimento, StringFormat=dd/MM/yyyy HH:mm}" Width="150" />
                <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*" />
                <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="120" />
                <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria}" Width="150" />
                <DataGridTextColumn Header="Valor" Binding="{Binding Valor, StringFormat=C}" Width="120" >
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Style.Triggers>
                                <!-- Se for Entrada (Tipo 1), fica verde. Saída, fica vermelho. -->
                                <DataTrigger Binding="{Binding Tipo}" Value="Entrada">
                                    <Setter Property="Foreground" Value="Green"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tipo}" Value="Saida">
                                    <Setter Property="Foreground" Value="#DC143C"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Coluna de Ações -->
                <DataGridTemplateColumn Header="Ações" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <!-- Botão Editar -->
                                <Button Style="{StaticResource MaterialDesignIconForegroundButton}"
                                        Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Editar Lançamento"
                                        Width="30" Height="30" Padding="0">
                                    <materialDesign:PackIcon Kind="Pencil" Width="18" Height="18" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                </Button>
                                
                                <!-- Botão Deletar -->
                                <Button Style="{StaticResource MaterialDesignIconForegroundButton}"
                                        Command="{Binding DataContext.DeletarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Excluir Lançamento"
                                        Width="30" Height="30" Padding="0" Margin="5,0,0,0">
                                    <materialDesign:PackIcon Kind="TrashCan" Width="18" Height="18" Foreground="#DC143C" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
